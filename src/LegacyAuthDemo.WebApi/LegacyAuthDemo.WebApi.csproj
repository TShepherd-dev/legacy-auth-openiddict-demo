<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyAuthDemo.Authorization\LegacyAuthDemo.Authorization.csproj" />
    <ProjectReference Include="..\LegacyAuthDemo.Domain\LegacyAuthDemo.Domain.csproj" />
  </ItemGroup>

  <!-- Azure deploy: copy the pre-built Vue SPA into wwwroot during publish.
       The CI workflow builds frontend/dist first and passes it via -p:SpaDistDir.
       Uses an explicit Copy into $(PublishDir): item-pipeline tricks
       (Content/LinkBase, ContentWithTargetPath) were silently dropped. -->
  <Target Name="IncludeSpaDist" AfterTargets="ComputeFilesToPublish" Condition="'$(SpaDistDir)' != ''">
    <ItemGroup>
      <_SpaFiles Include="$(SpaDistDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpaFiles)"
          DestinationFiles="@(_SpaFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
