<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyAuthDemo.Authorization\LegacyAuthDemo.Authorization.csproj" />
    <ProjectReference Include="..\LegacyAuthDemo.Domain\LegacyAuthDemo.Domain.csproj" />
  </ItemGroup>

  <!-- Azure deploy: copy the pre-built Vue SPA into wwwroot during publish.
       The CI workflow builds frontend/dist first and passes it via -p:SpaDistDir.
       NOTE: forward slashes are required - backslash globs match nothing on
       Linux build agents. -->
  <Target Name="IncludeSpaDist" BeforeTargets="ComputeFilesToPublish" Condition="'$(SpaDistDir)' != ''">
    <ItemGroup>
      <Content Include="$(SpaDistDir)/**/*" CopyToPublishDirectory="PreserveNewest" LinkBase="wwwroot/" />
    </ItemGroup>
  </Target>

</Project>
